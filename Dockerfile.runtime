FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-postgres.txt requirements-messaging.txt requirements-risk-state.txt ./
RUN pip install --no-cache-dir --disable-pip-version-check \
    -r requirements-postgres.txt \
    -r requirements-messaging.txt \
    -r requirements-risk-state.txt

COPY . /app

# Fail the image build if a production Kubernetes command references a module
# omitted or made unimportable by the release source tree.
RUN python3 -m scripts.verify_runtime_entrypoints
