# Trading Control API — production environment.
# Copy to deploy/prod/control_api.env (gitignored) and adjust.
#
# Keep the API bound to loopback. cloudflared reaches it on 127.0.0.1; nothing
# should ever listen on a public interface.
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=22349

# Comma-separated browser origins allowed to call the API (CORS).
CONTROL_API_CORS_ORIGINS=https://console.stratrelay.app
