__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
*.key
*.pem
*.pid
*.log
*.jsonl
*.csv
*_results.json
*_summary*.md
*_audit.json
*_audit.md
*_cohort.json
*_state_compact.json
archive/
runtime/
artifacts/

# Keep reproducible manifests/configuration and protocol fixtures.
!**/*_manifest.json
!orchestration/config/*.json
!protocol/**/*.json
!deploy/**/*.json
!contracts/**/*.json
!postgres/**/*.json

# The bare `runtime/` rule above targets local runtime-data directories (e.g. scratch
# TRADING_PLATFORM_RUNTIME_DIR output); trade_management/runtime/ (architecture/p4-2-runtime)
# is source code, not generated runtime data, and must stay tracked. __pycache__ under it
# stays ignored, per the top-level rule.
!trade_management/runtime/
!trade_management/runtime/**
trade_management/runtime/__pycache__/
